# Docker Compose PostgreSQL password. Use a long URL-safe random hex value.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

# Optional for local development; leave unset to use the in-memory development store.
# DATABASE_URL=postgresql://launchlab:password@localhost:5432/launchlab
# PGSSL=false

# Set to a long random value on your host. Reserved for future authentication integration.
APP_SECRET=replace-with-a-long-random-secret

# Optional: server-side keys for future integrations. No live API/AI integration is active yet.
NASA_API_KEY=
OPENAI_API_KEY=
